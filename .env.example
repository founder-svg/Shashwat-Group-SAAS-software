# ==============================================================================
# SHASHWAT GROUP SAAS & CRM SOFTWARE - ENVIRONMENT CONFIGURATION
# (All recommended third-party tools listed below have 100% FREE tiers)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="Shashwat Group CRM"
APP_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_change_in_production_shashwat_group_2026
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 1. DATABASE OPTIONS (100% Free Cloud Database)
# ------------------------------------------------------------------------------
# Option A: Supabase PostgreSQL (FREE Tier: 500MB DB, pooling, RLS) - Recommended
# Option B: Neon Serverless Postgres (FREE Tier: 0.5GB compute, 3GB storage)
# Option C: Local PostgreSQL or SQLite fallback
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase Free API Keys (if using direct Supabase client)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# 2. CLOUD STORAGE (100% Free Cloud Storage)
# ------------------------------------------------------------------------------
# Storage Provider: 'supabase' | 'cloudinary' | 'local'
STORAGE_PROVIDER=local

# Provider 1: Supabase Storage (1GB Free Storage)
SUPABASE_STORAGE_BUCKET=crm-documents

# Provider 2: Cloudinary (25GB Free Storage / Bandwidth - Best for files/images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (100% Free Tier)
# ------------------------------------------------------------------------------
# Resend (3,000 free emails/month) or Gmail SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_free_resend_api_key
EMAIL_FROM=notifications@shashwatgroup.com
